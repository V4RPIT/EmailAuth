{
  "description": "Controlled Authoritative DNS Zone Store for EmailAuth - a Secure Email Authentication Gateway with SPF, DKIM, and DMARC1",
  "records": {
    "securemail.example": {
      "TXT": [
        "v=spf1 ip4:198.51.100.10 ip4:203.0.113.0/24 ip6:2001:db8:cafe::/48 -all"
      ],
      "MX": [
        "10 mx-gw.securemail.example"
      ]
    },
    "selector1._domainkey.securemail.example": {
      "TXT": [
        "v=DKIM1; k=rsa; h=sha256; "
      ]
    },
    "_dmarc.securemail.example": {
      "TXT": [
        "v=DMARC1; p=reject; adkim=s; aspf=s; pct=100; sp=reject; rua=mailto:dmarc-reports@securemail.example; ruf=mailto:dmarc-forensic@securemail.example; fo=1"
      ]
    },
    "mx-gw.securemail.example": {
      "A": [
        "198.51.100.10"
      ]
    },
    "relay-mailer.example": {
      "TXT": [
        "v=spf1 ip4:192.0.2.55 -all"
      ]
    }
  }
}